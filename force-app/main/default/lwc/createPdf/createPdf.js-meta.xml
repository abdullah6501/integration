            <property name="qbId" type="String" label="QB Id" description="The QB Id" />
        
        </targetConfig>
        <targetConfig targets="lightning__FlowScreen">
            <property name="recordId" type="String" role="inputOnly" label="Record Id" description="The ID of the record to process" />
            <property name="qbId" type="String" role="inputOnly" label="QB Id" description="The QB Id" />
   
        </targetConfig>
    </targetConfigs>
